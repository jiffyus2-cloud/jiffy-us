rules_version = '2';

// Reglas de Cloud Storage.
//
// Este archivo es la copia versionada de lo que está publicado. Si alguien las
// edita desde la consola, el repo deja de reflejar la realidad: `npm run
// rules:check` compara ambas y avisa.
//
// OJO con el orden mental: en Storage las reglas se combinan con OR. Basta que
// UNA coincidencia permita la operación para que se permita. Un bloque más
// específico no "restringe" al general.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Permite leer y escribir a cualquier usuario que haya iniciado sesión en tu app
      allow read, write: if request.auth != null;
    }
    // Imágenes de la tienda que se cambian desde el panel de administración
    match /system_images/{allPaths=**} {
      // Lectura pública: las ve cualquier visitante de la tienda, sin sesión.
      allow read: if true;
      allow write, delete: if request.auth != null
                           && request.auth.token.email == 'jiffyus2@gmail.com';
    }
  }
}
