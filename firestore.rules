rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.token.email == 'memorias@jiffyphotos.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerOfDoc() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Orders collection
    match /orders/{orderId} {
      // Owner can do everything
      allow read, write, delete: if isOwner();

      // Authenticated users can read their own orders
      allow read: if isOwnerOfDoc();

      // Authenticated users can create orders with their own userId
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // Authenticated users can update their own orders only when not in locked production states
      allow update: if isOwnerOfDoc() &&
        !(resource.data.status in ['en_produccion', 'enviado', 'entregado']);

      // Users can delete their own drafts
      allow delete: if isOwnerOfDoc();
    }

    // Users collection
    match /users/{userId} {
      // Owner can read all user profiles
      allow read: if isOwner();

      // Users can read and write their own profile
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Settings collection (store config, etc.)
    match /settings/{document} {
      // Anyone can read settings (needed for store config in the app)
      allow read: if true;

      // Only owner can write settings
      allow write: if isOwner();
    }
  }
}
